{
  "openapi": "3.0.3",
  "info": {
    "title": "Sample Project API (intentional drift vs controller)",
    "version": "1.0.0"
  },
  "paths": {
    "/api/projects/{projectId}/files": {
      "post": {
        "summary": "Upload project file",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "thumbnailUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/detail": {
      "get": {
        "summary": "Project detail",
        "responses": {
          "200": {
            "description": "Detail row",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
